---
import presentation from "@/data/presentation";
import SocialLinks from "../SocialLinks.astro";
import convertAsteriskToStrongTag from "@/utils/convertAsteriskToStrongTag";
---

<article class="flex flex-col gap-8">
  <div class="flex flex-col gap-8">
    <div class="flex justify-center md:justify-start">
      <img
        src="/me.jpg"
        alt={presentation.title}
        class="w-36 h-36 md:w-40 md:h-40 rounded-full object-cover border-2 border-yellow-400/40"
      />
    </div>

    <div class="flex flex-col gap-8">
      <p
        class="w-auto max-w-[60ch] text-slate-300 leading-relaxed"
        set:html={convertAsteriskToStrongTag(presentation.description)}
      />

      <SocialLinks />

      <p class="text-slate-300 text-sm">
        Contact me here:
        <a
          href={`mailto:${presentation.mail}`}
          class="text-yellow-400 hover:text-yellow-300 underline transition-colors"
        >
          {presentation.mail}
        </a>
      </p>
    </div>
  </div>
</article>