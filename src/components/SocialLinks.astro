---
import presentation from "@/data/presentation";
import IG from "./icons/IG.astro";
import LinkedIn from "./icons/LinkedIn.astro";
---

<ul role="list" class="flex flex-row items-center gap-4">
  <li>
    <a
      href={presentation.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="group flex items-center gap-2 text-sm font-medium text-neutral-400 hover:text-white transition-colors"
    >
      <LinkedIn class="w-5 h-5 opacity-70 group-hover:opacity-100 transition-opacity" />
      <span class="hidden md:inline">LinkedIn</span>
    </a>
  </li>
  <li>
    <a
      href={presentation.instagram}
      target="_blank"
      rel="noopener noreferrer"
      class="group flex items-center gap-2 text-sm font-medium text-neutral-400 hover:text-white transition-colors"
    >
      <IG class="w-5 h-5 opacity-70 group-hover:opacity-100 transition-opacity" />
      <span class="hidden md:inline">Instagram</span>
    </a>
  </li>
</ul>